<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PDF Herramienta"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Todo lo que necesitas para trabajar con archivos PDF"
            android:textSize="16sp"
            android:gravity="center"
            android:paddingBottom="24dp" />

        <Button
            android:id="@+id/btnVerPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📄  VER PDF"
            android:textSize="17sp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnEditarPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✏️  EDITAR PDF"
            android:textSize="17sp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnFirmarPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✍️  FIRMAR PDF"
            android:textSize="17sp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnImagenPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🖼️  IMÁGENES A PDF"
            android:textSize="17sp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnUnirPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔗  UNIR PDF"
            android:textSize="17sp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnCompartirPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📤  COMPARTIR PDF"
            android:textSize="17sp"
            android:layout_marginBottom="10dp" />

    </LinearLayout>

</ScrollView>